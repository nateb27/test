{
  "name": "rts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "art:palette": "node scripts/art-tool.mjs palette",
    "art:units": "node scripts/art/run.mjs units",
    "art:trees": "node scripts/art/run.mjs trees",
    "art:sheets": "node scripts/art/run.mjs pack"
  },
  "dependencies": {
    "pixi.js": "^8.23.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
